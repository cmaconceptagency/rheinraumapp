# Kopieren nach apps/backend/.env und Werte anpassen. Die .env-Datei NIE committen.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# PostgreSQL (siehe docker-compose.yml im Projektwurzelverzeichnis)
DATABASE_URL=postgres://handwerk:handwerk@localhost:5432/handwerk

# Zufälligen Wert erzeugen, z. B.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=bitte-durch-einen-langen-zufaelligen-wert-ersetzen
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_DAYS=7

# Erlaubte Origins der Admin-Weboberfläche (kommagetrennt)
CORS_ORIGINS=http://localhost:5173

# Private Fotoablage (außerhalb jedes öffentlichen Verzeichnisses)
STORAGE_DIR=./storage/photos
MAX_UPLOAD_MB=10

# Standortprüfung beim Einstempeln
LOCATION_MAX_ACCURACY_M=100
LOCATION_MAX_AGE_S=120

# Routing für Entfernung Wohnort → Baustelle: simulated | osrm
# simulated = Luftlinie × 1,3 (deutlich als SIMULIERT gekennzeichnet)
ROUTING_PROVIDER=simulated
# Für osrm einen eigenen OSRM-Server verwenden (der öffentliche Demo-Server ist nicht für Produktion gedacht)
OSRM_URL=https://router.project-osrm.org

LOG_LEVEL=info
