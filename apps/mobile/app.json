{
  "expo": {
    "name": "Rheinraum Zeiterfassung",
    "slug": "rheinraum-zeiterfassung",
    "scheme": "rheinraum",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#123D6B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.example.rheinraum"
    },
    "android": {
      "package": "de.example.rheinraum",
      "adaptiveIcon": {
        "backgroundColor": "#123D6B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ihr Standort wird nur beim Einstempeln einmalig abgefragt, um zu prüfen, ob Sie sich an der Baustelle befinden. Es findet keine dauerhafte Ortung statt.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Der Zugriff auf Fotos wird benötigt, um Bilder zu Tätigkeitsberichten hinzuzufügen.",
          "cameraPermission": "Die Kamera wird für Fotos zu Tätigkeitsberichten verwendet.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
